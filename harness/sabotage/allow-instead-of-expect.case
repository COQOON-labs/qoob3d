# `#[allow]` instead of `#[expect(…, reason)]` (ADR-0040)
command: cargo clippy -p qoob3d-core --all-targets -- -D warnings
expect: #[allow] attribute found
--- patch
diff --git a/crates/qoob3d-core/src/mesh.rs b/crates/qoob3d-core/src/mesh.rs
--- a/crates/qoob3d-core/src/mesh.rs
+++ b/crates/qoob3d-core/src/mesh.rs
@@ -295,3 +295,6 @@
 
 #[cfg(test)]
 mod tests;
+
+#[allow(dead_code)]
+fn unused() {}
