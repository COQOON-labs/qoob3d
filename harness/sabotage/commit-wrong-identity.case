# A commit is made with another identity than harness/identity.txt (ADR-0044)
command: cargo xtask commits HEAD^..HEAD
expect: is not the project identity
identity: Someone Else <someone@example.com>
message: core: note on profiles
--- patch
diff --git a/crates/qoob3d-core/src/profile.rs b/crates/qoob3d-core/src/profile.rs
--- a/crates/qoob3d-core/src/profile.rs
+++ b/crates/qoob3d-core/src/profile.rs
@@ -33,3 +33,5 @@
 
 #[cfg(test)]
 mod tests;
+
+// sabotage
