# The plan reads escape rows only from the tip again: a range that deletes
# the row naming its file drops its own `escape` trigger (ADR-0052 fix
# round 1, F5)
command: cargo test -p xtask --quiet plan_range_keeps_escape_rows_the_range_removes
expect: plan_range_keeps_escape_rows_the_range_removes
--- patch
diff --git a/xtask/src/review.rs b/xtask/src/review.rs
--- a/xtask/src/review.rs
+++ b/xtask/src/review.rs
@@ -246,3 +246,3 @@
     }
-    plan(&changes, &union(&logs), tip_date.trim())
+    plan(&changes, &logs[0], tip_date.trim())
 }
