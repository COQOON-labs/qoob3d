# Agent removes a harness directory through a tee heredoc: tee copies the
# body to stdout as well, so it is no message form; its body is shell text
# (ADR-0037, ADR-0043, ADR-0049; critic finding on 95cc163, user decision
# 2026-10-15)
command: cargo xtask guard
expect: could modify the harness file `harness
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "tee /tmp/x <<EOF\nrm -rf harness\nEOF"}, "hook_event_name": "PreToolUse"}
