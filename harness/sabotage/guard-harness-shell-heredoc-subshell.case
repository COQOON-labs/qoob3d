# Agent feeds a heredoc to bash in a subshell opened after the marker: bash
# runs the body; only nothing (or one output redirection) after the marker
# makes a heredoc body data (ADR-0037, ADR-0043, ADR-0049; critic finding on
# 0cf5dd6)
command: cargo xtask guard
expect: could modify the harness file `xtask
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "cat <<EOF | (\nrm -rf xtask\nEOF\nbash)"}, "hook_event_name": "PreToolUse"}
