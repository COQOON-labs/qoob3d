# The hooks build xtask but no longer strip com.apple.quarantine from it, so a
# commit or push from Sourcetree fails because Gatekeeper refuses the binary (ADR-0051)
command: cargo test -p xtask --quiet hooks_build_xtask_and_strip_the_macos_quarantine_before_running_it
expect: lib.sh must remove com.apple.quarantine
--- patch
diff --git a/.githooks/lib.sh b/.githooks/lib.sh
--- a/.githooks/lib.sh
+++ b/.githooks/lib.sh
@@ -18,3 +18,2 @@
     if [ -f "$xtask_binary" ]; then
-      xattr -d com.apple.quarantine "$xtask_binary" 2>/dev/null || true
     else
