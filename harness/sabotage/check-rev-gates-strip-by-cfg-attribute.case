# build_xtask gates the quarantine strip with a `#[cfg(target_os = "macos")]`
# item again, so xtask_binary is dead code on Linux and clippy -D warnings fails
# there (ADR-0051)
command: cargo test -p xtask --quiet check_rev_builds_xtask_and_strips_the_macos_quarantine_before_the_check
expect: dead code on Linux
--- patch
diff --git a/xtask/src/worktree.rs b/xtask/src/worktree.rs
--- a/xtask/src/worktree.rs
+++ b/xtask/src/worktree.rs
@@ -77,3 +77,4 @@
     }
-    if cfg!(target_os = "macos") {
+    #[cfg(target_os = "macos")]
+    {
         // A non-zero exit means the attribute is missing (no GUI client involved): nothing
