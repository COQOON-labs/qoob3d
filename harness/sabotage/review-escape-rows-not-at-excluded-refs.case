# The plan no longer reads escape rows at the excluded refs of the range: a
# branch that forked before a row landed on main misses the row when the
# hook plans `<tip> --not <remote>/main` (ADR-0052 fix round 2, S1)
command: cargo test -p xtask --quiet plan_range_reads_escape_rows_at_excluded_refs
expect: plan_range_reads_escape_rows_at_excluded_refs
--- patch
diff --git a/xtask/src/review.rs b/xtask/src/review.rs
--- a/xtask/src/review.rs
+++ b/xtask/src/review.rs
@@ -292,5 +292,5 @@
     let mut logs = BTreeSet::from([now.clone()]);
     let mut earlier = BTreeSet::new();
-    for commit in boundaries.iter().map(String::as_str).chain(excluded) {
+    for commit in boundaries.iter().map(String::as_str) {
         let log = escape_log(root, commit)?;
         // Only an ancestor of the tip was in the branch: a row that landed on
