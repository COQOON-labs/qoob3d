# Agent feeds a cat heredoc to bash through a fifo opened by an earlier
# command: a message form makes its body data only when it is the whole
# command (ADR-0037, ADR-0043, ADR-0049; critic finding on 95cc163)
command: cargo xtask guard
expect: could modify the harness file `xtask
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "mkfifo /tmp/p\nbash < /tmp/p &\ncat > /tmp/p <<EOF\nrm -rf xtask\nEOF"}, "hook_event_name": "PreToolUse"}
