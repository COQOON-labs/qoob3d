# A lint suppression hidden in #[cfg_attr(<pred>, expect(…))] still counts
# for the ratchet (ADR-0040)
command: cargo xtask hygiene
expect: lint suppressions (#[expect]),
--- patch
diff --git a/crates/qoob3d-core/src/profile.rs b/crates/qoob3d-core/src/profile.rs
--- a/crates/qoob3d-core/src/profile.rs
+++ b/crates/qoob3d-core/src/profile.rs
@@ -33,3 +33,8 @@
 
 #[cfg(test)]
 mod tests;
+
+#[cfg_attr(all(), expect(clippy::unwrap_used, reason = "sabotage"))]
+fn sabotage() -> u8 {
+    "1".parse().unwrap()
+}
