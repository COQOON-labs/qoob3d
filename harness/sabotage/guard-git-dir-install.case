# A writer the guard does not list (`install`) replaces the guard binary under .git/, even unlocked (ADR-0043)
command: cargo xtask guard
expect: `.git/` is managed by git and the guard
env: QOOB3D_HARNESS_UNLOCK=1
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "install -m 755 /tmp/fake .git/qoob3d/guard-target/debug/xtask"}, "hook_event_name": "PreToolUse"}
