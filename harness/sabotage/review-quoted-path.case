# `cargo xtask review` reads `git log --numstat` without `-z` again: git
# quotes a non-ASCII, tab, `"` or `\` path, the quoted name is no code path,
# and a code change passes without a critic record (ADR-0041, ADR-0052;
# critic finding N3 on 0600f48)
command: cargo test -p xtask --quiet quoted_code_paths_need_a_critic_record
expect: quoted_code_paths_need_a_critic_record
--- patch
diff --git a/xtask/src/review.rs b/xtask/src/review.rs
--- a/xtask/src/review.rs
+++ b/xtask/src/review.rs
@@ -221,9 +221,9 @@
     // `-z`: paths unquoted, as they are (git quotes non-ASCII, tab, `"`, `\`).
     // `--no-renames`: a rename changes the old path too. `remerge`: what a
     // merge commit changes beyond merging its parents (conflict resolutions).
-    let mut args = vec!["log", "--format=", "--numstat", "--no-renames", "-z"];
+    let mut args = vec!["log", "--format=", "--numstat", "--no-renames"];
     args.extend(["--diff-merges=remerge"].into_iter().chain(revs.clone()));
     let numstat = git(&args)?;
     let changes: Vec<(&str, usize)> = numstat
-        .split('\0')
+        .lines()
         .filter_map(|entry| {
