# Agent spells the git directory through `git rev-parse` to replace a git hook (ADR-0043)
command: cargo xtask guard
expect: `.git/` is managed by git and the guard
env: QOOB3D_HARNESS_UNLOCK=1
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "cp /tmp/x \"$(git rev-parse --git-path hooks)/pre-push\""}, "hook_event_name": "PreToolUse"}
