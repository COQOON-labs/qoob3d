# The pre-push hook checks the working tree again instead of the tip of each pushed ref (ADR-0048)
command: cargo test -p xtask --quiet pre_push_checks_the_tip_of_each_pushed_ref_not_the_working_tree
expect: pre_push_checks_the_tip_of_each_pushed_ref_not_the_working_tree
--- patch
diff --git a/.githooks/pre-push b/.githooks/pre-push
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -56,2 +56,2 @@
-  "$xtask_binary" check-rev "$local_sha"
+  "$xtask_binary" check
 done
