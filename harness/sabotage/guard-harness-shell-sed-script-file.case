# Agent runs a sed script from a file on a harness file: the script may
# hold `w` or `e`, so sed counts as writing (ADR-0037, ADR-0043;
# implementer finding F3 on 445650c)
command: cargo xtask guard
expect: could modify the harness file `xtask/
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "sed -f /tmp/s.sed xtask/src/guard.rs"}, "hook_event_name": "PreToolUse"}
