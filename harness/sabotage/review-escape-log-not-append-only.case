# The plan no longer checks that the escape log is append-only: a range that
# deletes a row of the log (here a docs-only range, tier none) plans without
# an error, so a row that would make later ranges high can be dropped
# silently (ADR-0052 decision 5, fix round 6, K-10)
command: cargo test -p xtask --quiet plan_range_rejects_a_deleted_escape_row
expect: plan_range_rejects_a_deleted_escape_row
--- patch
diff --git a/xtask/src/review.rs b/xtask/src/review.rs
--- a/xtask/src/review.rs
+++ b/xtask/src/review.rs
@@ -304,3 +304,2 @@
     let plan = plan(&changes, &escapes, tip_date.trim())?;
-    append_only(&now, &earlier)?;
     Ok((plan, boundaries))
