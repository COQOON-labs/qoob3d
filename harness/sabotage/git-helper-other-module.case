# docs.rs spawns git itself instead of using the shared git helper, so a
# GIT_DIR exported by a hook would point it at another repository (one git
# helper for every xtask module, ADR-0048; critic K-13 on bd0fade)
command: cargo test -p xtask --quiet no_module_but_main_spawns_git_itself
expect: docs.rs builds its own git command
--- patch
diff --git a/xtask/src/docs.rs b/xtask/src/docs.rs
--- a/xtask/src/docs.rs
+++ b/xtask/src/docs.rs
@@ -306,4 +306,10 @@
 }

+/// A git runner of its own that inherits the hook's GIT_DIR.
+#[expect(dead_code, reason = "sabotage")]
+fn git_log(dir: &std::path::Path) -> std::io::Result<std::process::Output> {
+    std::process::Command::new("git").arg("log").current_dir(dir).output()
+}
+
 #[cfg(test)]
 mod tests;
