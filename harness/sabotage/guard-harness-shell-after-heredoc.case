# Agent hides a harness write after a heredoc: the body ends at its terminator
# line, the next line is shell again (ADR-0037, ADR-0043; critic K-15 on
# bd0fade: only the heredoc body is prose)
command: cargo xtask guard
expect: could modify the harness file `xtask
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "cat > /tmp/note <<EOF\nthe harness notes\nEOF\nrm -rf xtask"}, "hook_event_name": "PreToolUse"}
