# Agent edits .git/config directly (e.g. to change the hooks path), even unlocked (ADR-0043)
command: cargo xtask guard
expect: `.git/` is managed by git and the guard
env: QOOB3D_HARNESS_UNLOCK=1
stdin: {"session_id": "selftest", "tool_name": "Edit", "tool_input": {"file_path": ".git/config", "old_string": "[core]", "new_string": "[core]\n\thookspath = /dev/null"}, "hook_event_name": "PreToolUse"}
