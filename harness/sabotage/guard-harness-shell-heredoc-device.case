# Agent writes a cat heredoc to /dev/stdout: a device target is no regular
# file, so the body is shell text (ADR-0037, ADR-0043, ADR-0049; critic
# finding on 95cc163)
command: cargo xtask guard
expect: could modify the harness file `xtask
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "cat > /dev/stdout <<EOF\nrm -rf xtask\nEOF"}, "hook_event_name": "PreToolUse"}
