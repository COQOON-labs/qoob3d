# Agent runs a harness removal in a commit message: under an unquoted
# marker the shell runs `$(…)` in the body before git reads it, so the body
# is data only without `$(` and `${` (ADR-0037, ADR-0043, ADR-0049; critic
# finding F1 on 445650c)
command: cargo xtask guard
expect: could modify the harness file `xtask
stdin: {"session_id": "selftest", "tool_name": "Bash", "tool_input": {"command": "git commit -F - <<EOF\n$(rm -rf xtask)\nEOF"}, "hook_event_name": "PreToolUse"}
