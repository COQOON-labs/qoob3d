# One more lint in an existing multi-lint #![expect(…)] adds a suppression
# without adding an attribute line; the ratchet counts lints (ADR-0040)
command: cargo xtask hygiene
expect: lint suppressions (#[expect]),
--- patch
diff --git a/crates/qoob3d-kernel/src/occt.rs b/crates/qoob3d-kernel/src/occt.rs
--- a/crates/qoob3d-kernel/src/occt.rs
+++ b/crates/qoob3d-kernel/src/occt.rs
@@ -1,5 +1,6 @@
 //! cxx bridge to QOOB3D's own OCCT wrappers in `cpp/` (ADR-0014).
 #![expect(
     unsafe_code,
     unreachable_pub,
+    dead_code,
     reason = "cxx generates the unsafe FFI glue and its pub items; the C++ side converts \
