# commit-msg runs `cargo xtask` again instead of the binary lib.sh built and
# un-quarantined: cargo re-links target/debug/xtask on every run, a client such
# as Sourcetree quarantines the new link, and Gatekeeper refuses it (ADR-0051)
command: cargo test -p xtask --quiet hooks_build_xtask_before_running_the_binary_directly
expect: still runs `cargo xtask`
--- patch
diff --git a/.githooks/commit-msg b/.githooks/commit-msg
--- a/.githooks/commit-msg
+++ b/.githooks/commit-msg
@@ -7 +7 @@
-exec "$xtask_binary" commits --message "$1"
+exec cargo xtask commits --message "$1"
